// An MCP server with two tools. Build:  pin build example.pn -o squares-mcp
// Use from Claude Code:  claude mcp add squares /full/path/to/squares-mcp
import mcp;

function tools(): list<mcp::Tool> {
    $sq = new mcp::Tool("squares", "The squares of 1 to n");
    $sq->param("n", "integer", "how many squares (1 to 1000)", true);
    $add = new mcp::Tool("add", "Add two numbers");
    $add->param("a", "number", "first number", true);
    $add->param("b", "number", "second number", true);
    return [$sq, $add];
}

function call(mcp::Request $r): void {
    $name = mcp::tool_name($r);
    $args = mcp::arguments($r);
    if ($name == "squares") {
        $n = json_int($args, "n");
        if ($n < 1 || $n > 1000) {
            mcp::reply_tool_error($r, "n must be between 1 and 1000");
            return;
        }
        list<int> $out = [];
        for ($i = 1; $i <= $n; $i++) { $out[] = $i * $i; }
        mcp::reply_text($r, json_encode($out));
        return;
    }
    if ($name == "add") {
        mcp::reply_text($r, strval(json_float($args, "a") + json_float($args, "b")));
        return;
    }
    mcp::reply_error($r, -32602, "unknown tool $name");
}

while (true) {
    $r = try mcp::next() catch ($e) { break; };
    if (mcp::basic($r, "squares", "1.0.0")) { continue; }
    if ($r->method == "tools/list") {
        mcp::reply_tools($r, tools());
    } elseif ($r->method == "tools/call") {
        call($r);
    } else {
        mcp::reply_error($r, -32601, "unknown method " . $r->method);
    }
}
